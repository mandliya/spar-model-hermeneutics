+
+def _tool_call_from_tool_code(content: str, tools: list[dict]) -> dict | None:
+    params = {t["function"]["name"]: list((t["function"].get("parameters") or {}).get("properties") or {})
+              for t in tools if t.get("type") == "function"}
+    types = {t["function"]["name"]: {k: (v or {}).get("type") for k, v in
+                                     ((t["function"].get("parameters") or {}).get("properties") or {}).items()}
+             for t in tools if t.get("type") == "function"}
+    # fenced blocks first, then any line that is nothing but a call (gemma sometimes ends a plain
+    # reply with a bare `[execute_command(command="...")]` line); prose never parses as code
+    candidates = _TOOL_CODE.findall(content or "") + [ln for ln in (content or "").splitlines()
+                                                     if ln.strip()[:1] in "[(" or ln.strip().split("(")[0].split(".")[-1] in params]
+    while candidates:
+        block = candidates.pop(0)
+        try:
+            tree = ast.parse(block.strip())
+        except SyntaxError:
+            continue
+        for node in ast.walk(tree):
+            # gemma sometimes quotes the call: ```json ["execute_command(command='...')"]```
+            if isinstance(node, ast.Constant) and isinstance(node.value, str) and "(" in node.value:
+                candidates.append(node.value)
+            if not isinstance(node, ast.Call):
+                continue
+            name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", None)
+            if name not in params:
+                continue
+            try:
+                args = {kw.arg: ast.literal_eval(kw.value) for kw in node.keywords if kw.arg}
+                positional = [ast.literal_eval(v) for v in node.args]
+            except (ValueError, SyntaxError):
+                continue
+            # gemma also writes `execute_command({"command": "ls"})`: one dict of the tool's own parameter
+            # names, passed positionally, is the arguments themselves (not the first parameter's value)
+            if (len(positional) == 1 and not args and isinstance(positional[0], dict) and positional[0]
+                    and set(positional[0]) <= set(params[name])):
+                args = dict(positional[0])
+            else:
+                args.update(dict(zip(params[name], positional)))
+            # a string parameter given a dict or list gets it as JSON text, as a schema-checked API would
+            args = {k: json.dumps(v) if types[name].get(k) == "string" and isinstance(v, (dict, list)) else v
+                    for k, v in args.items()}
+            return {"id": f"call_{uuid.uuid4().hex[:24]}", "type": "function",
+                    "function": {"name": name, "arguments": json.dumps(args)}}
+    return None
+
+
+# Text-mode tool calling (agent.text_tools: true), for models with no tool-call tokens (gemma-3): the
+# request carries no `tools`; the system prompt carries Google's Gemma 3 function-calling instruction
+# (verbatim, from philschmid.de/gemma-function-calling, the reference Google points to) and the tools as
+# Python stubs; every earlier call in the history (this model's or another's, e.g. Qwen's in a swap) is
+# shown as a ```tool_code``` block and every tool result as a ```tool_output``` block in a user turn.
+# The reply is parsed back into a structured call (_tool_call_from_tool_code), so the stored history,
+# checkpoints and transcripts keep the standard format. Nothing is dropped by a provider-side parser.
+TEXT_TOOLS_INSTRUCTION = (
+    "At each turn, if you decide to invoke any of the function(s), it should be wrapped with ```tool_code```. "
+    "The python methods described below are imported and available, you can only use defined methods. "
+    "The generated code should be readable and efficient. The response to a method will be wrapped in "
+    "```tool_output``` use it to call more tools or generate a helpful, friendly response. When using a "
+    "```tool_call``` think step by step why and how it should be used.")
+_PY_TYPES = {"string": "str", "integer": "int", "number": "float", "boolean": "bool", "array": "list", "object": "dict"}
+
+
+def _python_stub(tool: dict) -> str:
+    """One tool as a Python signature with its description and arguments as the docstring."""
+    fn = tool["function"]; params = fn.get("parameters") or {}
+    props = params.get("properties") or {}; required = set(params.get("required") or [])
+    sig = ", ".join(f"{k}: {_PY_TYPES.get(v.get('type'), 'str')}" + ("" if k in required else " = None")
+                    for k, v in props.items())
+    doc = [fn.get("description", "").strip()]
+    if props:
+        doc += ["", "Args:"] + [f"  {k}: {(v.get('description') or '').strip()}" for k, v in props.items()]
+    body = "\n".join("    " + ln if ln else "" for ln in doc)
+    return f'def {fn["name"]}({sig}) -> str:\n    """\n{body}\n    """'
+
+
+def _call_text(name: str, arguments: str) -> str:
+    try:
+        args = json.loads(arguments) if arguments else {}
+        args = json.loads(args) if isinstance(args, str) else args
+    except (ValueError, TypeError):
+        return f"{name}()"
+    return f"{name}(" + ", ".join(f"{k}={v!r}" for k, v in (args or {}).items()) + ")"
+
+
+def _text_tools_messages(messages: list[dict], tools: list[dict]) -> list[dict]:
+    """The history as a model without tool-call tokens sees it (see TEXT_TOOLS_INSTRUCTION)."""
+    preamble = (TEXT_TOOLS_INSTRUCTION + "\n\nThe following Python methods are available:\n\n```python\n"
+                + "\n\n".join(_python_stub(t) for t in tools if t.get("type") == "function") + "\n```")
+    out: list[dict] = []
+    for m in messages:
+        role, content = m["role"], m.get("content")
+        content = content if isinstance(content, str) else ("" if content is None else json.dumps(content))
+        if role == "system":
+            out.append({"role": "system", "content": f"{content}\n\n{preamble}"})
+        elif role == "assistant":
+            text = content
+            # a call already written as text (this model's own turn) is shown as written
+            if m.get("tool_calls") and not _tool_call_from_tool_code(text, tools):
+                blocks = [f"```tool_code\n{_call_text(tc['function']['name'], tc['function'].get('arguments'))}\n```"
+                          for tc in m["tool_calls"]]
+                text = "\n".join([text.strip()] + blocks if text.strip() else blocks)
+            out.append({"role": "assistant", "content": text})
+        else:   # tool results and mid-run user messages: one user turn, so turns keep alternating
+            text = f"```tool_output\n{content}\n```" if role == "tool" else content
+            if out and out[-1]["role"] == "user":
+                out[-1]["content"] += "\n\n" + text
+            else:
+                out.append({"role": "user", "content": text})
+    if not any(m["role"] == "system" for m in out):
+        first = next((m for m in out if m["role"] == "user"), None)
+        if first is not None:
+            first["content"] = f"{preamble}\n\n{first['content']}"
+    return out
+
