+# =============================================================================
+# SERVER-SIDE DISPATCH (--server-dispatch)
+# =============================================================================
+#
+# run_isolated_jobs drives the sandboxes from the launching machine: its threads start each
+# sandbox and start the next as one finishes, so that machine must stay up until the whole fleet
+# is done. With --server-dispatch the same loop runs in a DEPLOYED Modal app
+# (scripts/modal_dispatcher.py; a call spawned into this ephemeral `modal run` app is never
+# scheduled once the entrypoint returns). The host resolves everything environment-specific and
+# hands it over as plain data: the sandbox image is built here and passed by id. Isolated,
+# non-sidecar runs only; same creation backoff, machine-gate redraws and rolling window.
+
+DISPATCH_APP = "agent-interp-envs-dispatch"   # scripts/modal_dispatcher.py, deployed once per workspace
