# Copy this file to .env and fill in your key.
# Get one at https://openrouter.ai/keys — add ~$5 of credit, that is plenty.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which slice of the dataset to work on.
# NEVER use "default" — that config's columns are misaligned.
# Run `uv run python 01_explore.py --list` to see all of them.
CONFIG=google-gemma-3-27b-it_megafolds_fold_1

# The model under test.
TARGET_MODEL=google/gemma-3-27b-it

# The lie judge. Must be stronger than the target and never the target itself.
JUDGE_MODEL=anthropic/claude-sonnet-4.5

# 1.0 matches how these evals are normally run. Set 0.0 for a deterministic
# baseline run, but then you are measuring the mode, not the behaviour.
TEMPERATURE=1.0

# Parallel API calls. Raise if you are being rate-limited less than you'd like.
MAX_WORKERS=8
