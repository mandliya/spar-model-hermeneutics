# Copy to .env and fill in. .env is gitignored.

# Write token, from https://huggingface.co/settings/tokens. Also needs the
# gated google/gemma-3-27b-it licence accepted on the Hub.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where every per-row record and hidden-state file is stored.
HF_DATASET_REPO=model-hermeneutics/dyl-probe-repro

# Only when this project is NOT inside a repo checkout: where the repo's gigi/
# folder is. The GPU box mirrors the repo layout, so it does not need this.
# GIGI_DIR=/workspace/spar-model-hermeneutics/gigi
