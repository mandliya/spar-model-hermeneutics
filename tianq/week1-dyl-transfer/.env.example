# Copy to .env and fill in. .env is gitignored — check with:
#   git check-ignore -v tianq/week1-dyl-transfer/.env
# Silence from that command means the key is about to be committed.

# Write token, from https://huggingface.co/settings/tokens
# Also needs the gated google/gemma-3-27b-it licence accepted on the Hub.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where every per-row record and activation is streamed.
HF_DATASET_REPO=model-hermeneutics/spar-dyl-ascii-transfer

# Only needed for black-box text work. Hosted APIs cannot return hidden
# states, so this is NOT usable for probe extraction.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx
